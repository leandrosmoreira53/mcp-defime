# ---- Cache (segundos) ----
CACHE_PATH=cache/defime.db
CACHE_TTL_SNAPSHOT=60
CACHE_TTL_HISTORY=600
CACHE_TTL_LIST=600
CACHE_TTL_SEARCH=300

# ---- HTTP ----
RATE_LIMIT_RPS=1
HTTP_CONNECT_TIMEOUT=10
HTTP_TOTAL_TIMEOUT=20
HTTP_MAX_RETRIES=3
HTTP_USER_AGENT=mcp-defime/0.1 (+https://github.com/leandrosmoreira53/mcp-defime)

# ---- Fontes ----
DEFAULT_CHAIN=robinhood
# rwa_bluechip = só Robinhood Chain, só pools de tokens RWA da Robinhood + cripto blue chip (ETH/WETH/cbBTC),
#                com USDG como contraparte. all = qualquer pool.
SCOPE=rwa_bluechip
# Sobrescrever as listas (endereço:símbolo, separados por vírgula). Vazio = padrão do código.
BLUECHIP_TOKENS=
STABLE_TOKENS=
CACHE_TTL_METADATA=86400
# Leitura on-chain da Robinhood Chain (taxa real do LP, preço e liquidez do contrato). Só eth_call.
ONCHAIN_ENABLED=true
ROBINHOOD_RPC_URLS=https://rpc-robinhood.blockmachine.io,https://rpc.mainnet.chain.robinhood.com


# ---- Servidor MCP ----
# stdio = local (Claude Code na mesma máquina) | http = VPS
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Obrigatório em http. Gere com: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
# Domínio(s) públicos que chegam pelo proxy reverso, ex.: mcp.seudominio.com
MCP_ALLOWED_HOSTS=
LOG_LEVEL=INFO
